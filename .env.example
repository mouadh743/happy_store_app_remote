# Copy this file to .env and fill in the values from
# Supabase Dashboard → Project Settings → API.
#
# Use the anon (public) key, or the newer "publishable" key (sb_publishable_…).
# NEVER put the service_role / secret key in this app: anything starting with
# EXPO_PUBLIC_ is bundled into the app and can be read by anyone who has it.
# Access is protected by the Row Level Security policies in supabase/migrations.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
